
{% if show_error %}
  <div class="layout layout--col layout--center">
    <span class="description">{{ show_error }}</span>
  </div>
{% else %}
  <div class="layout layout--col layout--center layout--center-y botc-layout">
    {% render "wiki_qr", wiki_url: wiki_url, show_qr_code: show_qr_code %}
    {% render "character_card",
      layout: "quadrant",
      name: name,
      type: type,
      ability: ability,
      flavor: flavor,
      icon_url: icon_url
    %}
  </div>
{% endif %}

{% render "title_bar", name: name, cycle_length: cycle_length, day_in_cycle: day_in_cycle %}
